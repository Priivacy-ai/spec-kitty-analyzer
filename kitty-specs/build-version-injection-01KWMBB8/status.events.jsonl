{"aggregate_id": "01KWMBB878K806KR7N6YAV67EK", "aggregate_type": "Mission", "event_id": "01KWMBBC4QDH0EX7A3Q5C08HGV", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-03T16:00:19.690729+00:00", "friendly_name": "Build Version & Metadata Injection", "mission_id": "01KWMBB878K806KR7N6YAV67EK", "mission_number": null, "mission_slug": "build-version-injection-01KWMBB8", "mission_type": "software-dev", "purpose_context": "Today the analyzer's version is a hardcoded Go constant that must be manually bumped to match each release tag, and shipped binaries carry no commit or build-date provenance. This mission injects version, commit SHA, and build date at release-build time via linker flags and surfaces them as a structured build object in the version command and report JSON, so every binary is traceable to the commit that produced it and no release ships a mismatched version again. Closes issues #19 and #21.", "purpose_tldr": "Binaries report their real version, commit, and build date from the release build instead of a hand-edited constant.", "target_branch": "feat/build-version-injection", "wp_count": 0}, "project_slug": "spec-kitty-analyzer", "project_uuid": "c0c408c0-66da-496c-aefe-221560dee3b2", "schema_version": "5.0.0", "timestamp": "2026-07-03T16:00:23.703342+00:00"}
